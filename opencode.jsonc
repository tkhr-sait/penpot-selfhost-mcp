{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "disabled_providers": ["opencode"],
  "autoupdate": false,
  "experimental": {
    "openTelemetry": false
  },
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://host.docker.internal:1234/v1"
      },
      // modalities
      // input: Array of supported input types: ["text", "audio", "image", "video", "pdf"]
      // output: Array of supported output types: ["text", "audio", "image", "video", "pdf"]          
      "models": {
        // 結局 penpot の知識がモデル内に無いため、スキル内容を充実させないと思うように動作しない。
        // penpotで利用できるjsがバグってたり、呼び出す順番が決まってたりが把握できてないので毎回試行錯誤。
        // エージェント的な動作を学習しているのは minimax くらい。
        // M4mac 128GB での動作
        // ok 画像は見れない
        "unsloth/minimax-m2.5@iq2_m": {
           // メモリに収まるし、実用的な速さ context-length: 196kくらい(Q8_0)
           "name": "unsloth/minimax-m2.5(2026.2,229B,IQ2_M,78GB)"
        },
        // ng.. ツールうまく呼べない
        //"mradermacher/minimax-m2.5-reap-139b-a10b-i1": {
        //   "name": "mradermacher/minimax-m2.5-reap(2026.2,139B,Q4_K_M,84GB)"
        //},
        // ng.. ツールうまく呼べない
        //"mradermacher/step-3.5-flash-i1": {
        //   "name": "mradermacher/step-3.5-flash-i1(2026.2,197B,IQ3_XXS,76GB)"
        //},
        // "unsloth/qwen3.5-397b-a17b": {
        //   // Visionがあるのが良い。が遅い... context-length: 90kくらいで125GB...
        //   "name": "unsloth/qwen3.5-397b-a17b(2026.2,397B,TQ1_0,96GB)",
        //   "modalities": {
        //     "input": ["text", "image"],
        //     "output": ["text"]
        //   }
        // },
        // "OpenMOSE/qwen3.5-reap-212b-a17b": {
        //   // ng..指示無視。397bのREAP版。Visionはomitされている。
        //   "name": "OpenMOSE/qwen3.5-reap-212b-a17b(2026.2,212B,IQ2_M,69GB)",
        //   "modalities": {
        //     "input": ["text"],
        //     "output": ["text"]
        //   }
        // },
        // // mlx遅い...
        // "mlx-community/qwen3.5-122b-a10b": {
        //   // Visionがあるのが良い。... context-length: 128kくらい
        //   "name": "mlx-community/qwen3.5-122b-a10b(2026.2,122B,5bit,85GB)",
        //   "modalities": {
        //     "input": ["text", "image"],
        //     "output": ["text"]
        //   }
        // },
        // 細かい指示必要。失敗すると抜け出せない。 画像見れる
        "unsloth/qwen3.5-122b-a10b": {
          // Visionがあるのが良い。... context-length: 256kくらい
          "name": "unsloth/qwen3.5-122b-a10b(2026.2,122B,Q4_K_XL,68GB)",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        // 細かい指示必要。結構指示を無視する。失敗すると抜け出せない。 画像見れる
        "unsloth/qwen3.5-35b-a3b": {
          // Visionがあるのが良い。... context-length: 256kくらい
          "name": "unsloth/qwen3.5-35b-a10b(2026.2,35B,Q4_K_XL,21GB)",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        //},
        // "glm-4.7-flash-reap-23b-a3b": {
        //   // 23Bだと知識量が少なすぎて無理
        //   "name": "unsloth/glm-4.7-flash-reap-23b-a3b(2026.1,23B,Q4_K_XL,14GB)",
        //   "modalities": {
        //     "input": ["text"],
        //     "output": ["text"]
        //   }
        // },
        // "unsloth/qwen3-coder-next": {
        //   // メモリに収まるし、実用的な速さ。だけど指示は無視.. context-length: 256kくらい指定できるが、動きは良くない...
        //   "name": "unsloth/qwen3-coder-next(2026.2,80B,Q6_K_XL,68GB)"
        }
      }
    }
  },
  "mcp": {
    "penpot-official": {
      "type": "local",
      "command": ["docker",
        "compose", "-f", ".claude/skills/penpot/scripts/mcp-proxy/docker-compose.yml",
        "run", "--build", "--rm", "-T", "penpot-proxy",
        "--upstream=http://localhost:4421/sse"
      ],
      "enabled": true
    },
    "storybook-mcp": {
      "type": "local",
      "command": ["docker",
        "compose", "-f", ".claude/skills/penpot/scripts/mcp-proxy/docker-compose.yml",
        "run", "--rm", "-T", "storybook-proxy",
        "--upstream=http://localhost:6007/sse"
      ],
      "enabled": true
    }
  },
  "agent": {
    "penpot-mcp": {
      "description": "Penpot MCP 操作の実行。ボード作成、テキスト配置、スタイル適用、トークン操作、デザイン検証など、複数の execute_code 呼び出しが必要なデザイン操作を委譲。前提: /penpot スキル（SKILL.md）のロード後にのみ使用。直接呼び出し禁止。",
      "mode": "subagent",
      "prompt": "{file:.claude/agents/penpot-mcp.md}",
      "tools": {
        "penpot-official_*": true,
        "read": true,
        "edit": false
      }
    }
  }
}
